{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bizsite-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-08-28",
  // Guarantees the *.workers.dev route on every deploy.
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Static assets are served before the Worker by default, and SPA
    // not-found handling would swallow /api/* into index.html.
    "run_worker_first": ["/api/*"]
  },
  // The 3D export ships its source design spec inside the zip. Bundling the
  // vendored prompts as text modules keeps vendor/ the single copy - no build
  // step, and no runtime asset fetch that could fail mid-download.
  "rules": [
    { "type": "Text", "globs": ["**/*.md"], "fallthrough": true }
  ],
  "observability": {
    "enabled": true
  }
}
